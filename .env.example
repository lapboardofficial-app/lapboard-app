NODE_ENV=development
HOST=0.0.0.0
PORT=3010

# Optional JSON fallback database for local testing without Supabase.
LAPBOARD_DB_PATH=./data/lapboard-db.json

# Comma-separated public website origins that may call the API.
# Leave blank in local dev. Set this in production if the frontend and API are hosted separately.
LAPBOARD_ALLOWED_ORIGINS=

# Serve the built React app from ./dist when running npm start.
LAPBOARD_SERVE_STATIC=true
LAPBOARD_PUBLIC_DIR=./dist

# Basic write protection for public APIs.
LAPBOARD_WRITE_RATE_LIMIT=120
LAPBOARD_WRITE_RATE_WINDOW_MS=60000
LAPBOARD_BODY_LIMIT_BYTES=2000000

# Supabase turns on real email/password accounts and Postgres shared data.
# In the browser, only use the anon/public key. Never put the service role key in Vite env vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
